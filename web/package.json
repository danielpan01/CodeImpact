{
  "name": "codeimpact-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test",
    "install:browsers": "PLAYWRIGHT_BROWSERS_PATH=0 playwright install chromium firefox webkit",
    "format:check": "prettier --check src tests scripts *.ts *.json",
    "test:visual": "node scripts/quality.mjs visual",
    "test:visual:update": "node scripts/quality.mjs update",
    "test:visual:preview": "node scripts/quality.mjs preview",
    "test:a11y": "node scripts/quality.mjs a11y",
    "quality:container": "node scripts/quality-container.mjs"
  },
  "dependencies": {
    "@xyflow/react": "12.12.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "8.3.6"
  }
}
