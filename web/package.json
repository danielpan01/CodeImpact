    "format:check": "prettier --check src tests *.ts *.json"
  },
  "dependencies": {
    "@xyflow/react": "12.12.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "8.3.6"
  }
}
