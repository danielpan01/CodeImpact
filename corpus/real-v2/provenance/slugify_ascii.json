  "change_url": "https://github.com/un33k/python-slugify/commit/cf6cd3dad45dea9641755adab80c00a9dbaee709",
  "head": {
    "commit": {
      "message": "Skip the transliteration backend for ASCII text (#201)\n\nEvery backend (text-unidecode, Unidecode, anyascii) maps 7-bit ASCII to\nitself, so ASCII input no longer imports one. With text-unidecode this\navoids loading its ~3 MB table for the common case of ASCII slugs.\nOutput is unchanged, including the frozen legacy differential.",
      "parents": [
        {
          "sha": "2fe6cec4842039814217cb8d089c6fcb9f8c154b"
        }
      ],
